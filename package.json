{
  "name": "quote-desk",
  "version": "0.1.0",
  "private": true,
  "description": "RFQ-to-quote costing for a machined and forged auto-component maker",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force && prisma db seed",
    "sample-data": "tsx --env-file-if-exists=.env scripts/generate-sample-data.ts",
    "format": "prettier --write .",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@react-pdf/renderer": "4.9.0",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "decimal.js": "10.6.0",
    "lucide-react": "1.67.0",
    "next": "16.4.2",
    "postal-mime": "4.2.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "unpdf": "1.9.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
