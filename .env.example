# Copy to .env and adjust. Never commit .env.

# Postgres. Local: the docker compose database. Hosted: Neon pooled connection string.
DATABASE_URL="postgresql://quotedesk:quotedesk@localhost:5433/quotedesk?schema=public"
# Direct (non-pooled) connection used by `prisma migrate`. Locally the same as DATABASE_URL.
DIRECT_URL="postgresql://quotedesk:quotedesk@localhost:5433/quotedesk?schema=public"

# Groq API key from https://console.groq.com. Leave empty to run intake on the rule-based fallback.
GROQ_API_KEY=""
GROQ_TEXT_MODEL="openai/gpt-oss-120b"
GROQ_VISION_MODEL="qwen/qwen3.8-27b"

# "true" shows the demo accounts on the sign-in page and enables the sales head's "Reset demo data".
DEMO_MODE="true"
# Optional: password given to the seeded demo accounts (defaults to the one in docs/deployment.md).
SEED_DEMO_PASSWORD=""
